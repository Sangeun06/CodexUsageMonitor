[Unit]
Description=Codex Usage Monitor
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sangeun/workspace/CodexUsageMonitor
ExecStart=/usr/bin/python3 /home/sangeun/workspace/CodexUsageMonitor/server.py --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sangeun/workspace/CodexUsageMonitor/data

[Install]
WantedBy=default.target
